+    private void BuildTrustedValidationParents()
+    {
+        // First Refresh has already admitted the bounded graph. Share each
+        // directory's immutable prefix strings across its files; retain no stat data.
+        var directories = new Dictionary<string, string[]>(StringComparer.Ordinal);
+        foreach (var info in trustedPaths)
+        {
+            if (externalCompilerInputs.Contains(info.FullName)) continue;
+            var parent = Path.GetDirectoryName(info.FullName)!;
+            if (!directories.TryGetValue(parent, out var prefixes))
+            {
+                var relative = Path.GetRelativePath(root!, parent);
+                if (relative == ".." || relative.StartsWith(".." + Path.DirectorySeparatorChar, PathComparison) || Path.IsPathRooted(relative))
+                    throw new UnauthorizedAccessException("Path escapes workspace");
+                var parts = new List<string>();
+                var current = root!;
+                if (relative != ".")
+                    foreach (var segment in relative.Split(Path.DirectorySeparatorChar))
+                    {
+                        current = Path.Combine(current, segment);
+                        parts.Add(current);
+                    }
+                directories.Add(parent, prefixes = parts.ToArray());
+            }
+            trustedValidationParents.Add(info.FullName, prefixes);
+        }
+    }
